# AIOS Stack — Environment Template
# Copy to .env and fill in values before running docker compose

# Required: Authentication secret (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=CHANGE_ME

# Public URL (update to VPS URL when deploying to production)
PAPERCLIP_PUBLIC_URL=http://localhost:3101

# Port mapping — 3101 to avoid conflict with local Paperclip on 3100
AIOS_PORT=3101
